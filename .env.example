APP_ENV=development
TRADING_MODE=BACKTEST
DATABASE_URL=sqlite:///./data/trading.db
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=127.0.0.1
API_PORT=8000
# LIVE is disabled unless all three are explicitly set:
# APP_ENV=production
# TRADING_MODE=LIVE
# ALLOW_LIVE_TRADING=true
ALLOW_LIVE_TRADING=false
MT5_LOGIN=112812620
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
MT5_TERMINAL_PATH="C:\LOGS\MT5 AI_1\terminal64.exe"
MT5_TIMEOUT_MS=60000
MT5_HEARTBEAT_SECONDS=15
MT5_MAGIC_NUMBER=26091801
MT5_MAX_SPREAD_POINTS=30
# Comma-separated market data universe used by collectors.
MARKET_SYMBOLS=EURUSD,GBPUSD,USDJPY
MARKET_TIMEFRAMES=M1,M5,M15,M30,H1,H4
# Emergency stop never closes positions automatically by default.
EMERGENCY_POSITION_POLICY=LEAVE_UNCHANGED
# Comma-separated operator IDs permitted to reactivate after an emergency stop.
CONTROL_RECOVERY_OPERATORS=
DATA_FEED_STALE_SECONDS=120
